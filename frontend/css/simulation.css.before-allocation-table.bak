/* =========================================================
   AVERTIQ — SIMULATION LAB
   File: frontend/css/simulation.css
========================================================= */

.simulation-page {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 28px;
    color: #172033;
    box-sizing: border-box;
}

.simulation-page *,
.simulation-page *::before,
.simulation-page *::after {
    box-sizing: border-box;
}

.simulation-page button,
.simulation-page input,
.simulation-page select {
    font: inherit;
}

/* PAGE HEADER */
.simulation-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 24px;
}

.simulation-heading .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 10px;
    color: #087f8c;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.simulation-heading h1 {
    margin: 0 0 10px;
    color: #152238;
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.25;
}

.simulation-heading p {
    max-width: 720px;
    margin: 0;
    color: #738096;
    font-size: 13px;
    line-height: 1.8;
}

.simulation-heading-badge {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 9px;
    padding: 11px 15px;
    border: 1px solid #c9e8df;
    border-radius: 10px;
    background: #effbf6;
    color: #197750;
    font-size: 11px;
    font-weight: 800;
}

.simulation-heading-badge i {
    font-size: 14px;
}

/* NOTICE */
.simulation-notice {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 17px;
    margin-bottom: 21px;
    border: 1px solid #cde5f5;
    border-radius: 12px;
    background: #f1f9ff;
}

.simulation-notice-icon {
    display: flex;
    flex: 0 0 37px;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    border-radius: 10px;
    background: #deefff;
    color: #246caa;
}

.simulation-notice strong {
    display: block;
    margin-bottom: 6px;
    color: #194d77;
    font-size: 12px;
    font-weight: 800;
}

.simulation-notice p {
    margin: 0;
    color: #57758e;
    font-size: 11px;
    line-height: 1.8;
}

/* STATUS MESSAGE */
.simulation-message {
    padding: 12px 15px;
    margin-bottom: 21px;
    border: 1px solid #dce5ee;
    border-radius: 9px;
    background: #f8fafc;
    color: #536176;
    font-size: 12px;
    line-height: 1.7;
}

.simulation-message:empty {
    display: none;
}

.simulation-message.info {
    border-color: #d4e5f4;
    background: #f3f9ff;
    color: #275d87;
}

.simulation-message.success {
    border-color: #bce8d0;
    background: #effcf5;
    color: #167344;
}

.simulation-message.error {
    border-color: #fecaca;
    background: #fff1f2;
    color: #b42332;
}

.simulation-message.warning {
    border-color: #f4d7a0;
    background: #fff9ec;
    color: #986318;
}

/* KPI GRID */
.simulation-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 23px;
}

.simulation-kpi-card {
    min-width: 0;
    padding: 20px;
    border: 1px solid #e5eaf1;
    border-radius: 14px;
    background: #ffffff;
    box-shadow: 0 5px 20px rgba(21, 42, 72, 0.035);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.simulation-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(21, 42, 72, 0.07);
}

.simulation-kpi-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 17px;
}

.simulation-kpi-top > span:first-child {
    color: #6d7a8e;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.6;
}

.simulation-kpi-icon {
    display: flex;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    font-size: 15px;
}

.simulation-kpi-icon.blue {
    background: #e7f1ff;
    color: #3779d8;
}

.simulation-kpi-icon.red {
    background: #fff0ef;
    color: #dc5555;
}

.simulation-kpi-icon.green {
    background: #e3f8ee;
    color: #16865a;
}

.simulation-kpi-icon.purple {
    background: #f0eaff;
    color: #7953c6;
}

.simulation-kpi-value {
    min-height: 38px;
    color: #17263d;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.3;
    overflow-wrap: anywhere;
}

.simulation-kpi-card > p {
    margin: 8px 0 0;
    color: #8995a6;
    font-size: 10px;
    line-height: 1.7;
}

/* WORKSPACE */
.simulation-workspace {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.5fr);
    align-items: start;
    gap: 20px;
    margin-bottom: 22px;
}

/* PANELS */
.simulation-panel {
    min-width: 0;
    padding: 23px;
    border: 1px solid #e5eaf1;
    border-radius: 15px;
    background: #ffffff;
    box-shadow: 0 5px 20px rgba(21, 42, 72, 0.035);
}

.simulation-panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 23px;
}

.simulation-panel-heading > div {
    min-width: 0;
}

.simulation-panel-heading h2 {
    margin: 0 0 8px;
    color: #1b2940;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.5;
}

.simulation-panel-heading p {
    margin: 0;
    color: #8591a3;
    font-size: 11px;
    line-height: 1.7;
}

.simulation-panel-icon {
    display: flex;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: #eaf5f5;
    color: #087f8c;
    font-size: 15px;
}

/* FORM CONTROLS */
.simulation-form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 17px;
}

.simulation-form-group label {
    color: #344258;
    font-size: 11px;
    font-weight: 800;
}

.simulation-input {
    width: 100%;
    min-width: 0;
    min-height: 43px;
    padding: 10px 12px;
    border: 1px solid #dce4ed;
    border-radius: 9px;
    outline: none;
    background: #ffffff;
    color: #28364a;
    font-size: 12px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.simulation-input:hover {
    border-color: #b7c8d8;
}

.simulation-input:focus {
    border-color: #168c96;
    box-shadow: 0 0 0 3px rgba(22, 140, 150, 0.1);
}

.simulation-input:disabled {
    background: #f3f6f9;
    color: #8591a3;
    cursor: not-allowed;
}

.simulation-form-group small {
    color: #8995a6;
    font-size: 10px;
    line-height: 1.7;
}

/* DIVIDERS */
.simulation-section-divider {
    height: 1px;
    margin: 22px 0;
    background: #edf0f5;
}

/* CONTROL SECTION */
.simulation-control-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
}

.simulation-control-icon {
    display: flex;
    flex: 0 0 37px;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    border-radius: 10px;
    font-size: 14px;
}

.simulation-control-icon.red {
    background: #fff0ef;
    color: #d94d4d;
}

.simulation-control-icon.green {
    background: #e3f8ee;
    color: #16865a;
}

.simulation-control-title h3 {
    margin: 0 0 5px;
    color: #29374b;
    font-size: 12px;
    font-weight: 800;
}

.simulation-control-title p {
    margin: 0;
    color: #8995a6;
    font-size: 10px;
    line-height: 1.6;
}

/* BUTTONS */
.simulation-button-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.simulation-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 13px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 11px;
    font-weight: 800;
    text-align: center;
    cursor: pointer;
    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
}

.simulation-button:hover:not(:disabled) {
    transform: translateY(-1px);
}

.simulation-button:focus-visible {
    outline: 3px solid rgba(8, 127, 140, 0.22);
    outline-offset: 2px;
}

.simulation-button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.simulation-button.primary {
    border-color: #087f8c;
    background: #087f8c;
    color: #ffffff;
}

.simulation-button.primary:hover:not(:disabled) {
    border-color: #066b76;
    background: #066b76;
}

.simulation-button.secondary {
    border-color: #dce4ed;
    background: #ffffff;
    color: #4a5a70;
}

.simulation-button.secondary:hover:not(:disabled) {
    background: #f5f8fb;
}

.simulation-button.danger {
    border-color: #f5cccc;
    background: #fff1f1;
    color: #bc3434;
}

.simulation-button.danger:hover:not(:disabled) {
    background: #ffe5e5;
}

.simulation-button.success {
    border-color: #c4e9d4;
    background: #effcf5;
    color: #18764a;
}

.simulation-button.success:hover:not(:disabled) {
    background: #e1f8eb;
}

.simulation-button.full-width {
    width: 100%;
}

.simulation-action-buttons {
    display: grid;
    gap: 10px;
    margin-top: 22px;
}

/* INLINE STATUS */
.simulation-inline-status {
    min-height: 18px;
    margin-top: 11px;
    color: #7d899b;
    font-size: 10px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.simulation-inline-status.success {
    color: #16834f;
}

.simulation-inline-status.error {
    color: #c13a3a;
}

.simulation-inline-status.warning {
    color: #a36b13;
}

/* SCENARIO INFO */
.simulation-scenario-info {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 16px;
    margin-bottom: 25px;
    border: 1px solid #e6edf3;
    border-radius: 11px;
    background: #f8fafc;
}

.simulation-scenario-info > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
}

.simulation-info-label {
    color: #8a96a7;
    font-size: 10px;
    font-weight: 600;
}

.simulation-scenario-info strong {
    color: #29384c;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.6;
    overflow-wrap: anywhere;
}

.simulation-mode-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #16764d !important;
}

.simulation-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #20a36a;
}

/* SUBHEADINGS */
.simulation-subheading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 22px 0 13px;
}

.simulation-subheading h3 {
    margin: 0;
    color: #29374b;
    font-size: 12px;
    font-weight: 800;
}

.simulation-subheading > span {
    color: #8a96a7;
    font-size: 10px;
    text-align: right;
}

/* TABLES */
.simulation-table-wrapper {
    width: 100%;
    overflow-x: auto;
    border: 1px solid #edf0f5;
    border-radius: 10px;
    scrollbar-width: thin;
}

.simulation-table {
    width: 100%;
    min-width: 430px;
    border-collapse: collapse;
    text-align: left;
}

.simulation-table thead {
    background: #f7f9fc;
}

.simulation-table th {
    padding: 13px 12px;
    border-bottom: 1px solid #e9edf3;
    color: #6c798d;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
}

.simulation-table td {
    padding: 13px 12px;
    border-bottom: 1px solid #edf1f5;
    color: #59677b;
    font-size: 10px;
    line-height: 1.7;
    vertical-align: middle;
}

.simulation-table tbody tr:last-child td {
    border-bottom: none;
}

.simulation-table tbody tr:hover {
    background: #f8fbfd;
}

.simulation-table td:first-child {
    color: #29374b;
    font-weight: 700;
}

.simulation-table-loading,
.simulation-table-empty {
    padding: 25px 12px !important;
    color: #8591a3 !important;
    text-align: center;
}

.simulation-road-badge,
.simulation-route-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 8px;
    border-radius: 20px;
    font-size: 9px;
    font-weight: 800;
    white-space: nowrap;
}

.simulation-road-badge.blocked,
.simulation-route-badge.unreachable {
    background: #fee8e8;
    color: #bd3030;
}

.simulation-road-badge.open,
.simulation-route-badge.reachable {
    background: #e4f7eb;
    color: #1c7b48;
}

.simulation-road-badge.unknown {
    background: #edf1f5;
    color: #637086;
}

/* RESULTS PANEL */
.simulation-results-panel {
    margin-bottom: 22px;
}

.simulation-results-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 42px 22px;
    border: 1px dashed #d7e1eb;
    border-radius: 12px;
    background: #fafcff;
    text-align: center;
}

.simulation-results-placeholder[hidden],
.simulation-results[hidden] {
    display: none !important;
}

.simulation-results-placeholder-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 59px;
    height: 59px;
    margin-bottom: 17px;
    border-radius: 17px;
    background: #e7f5f6;
    color: #087f8c;
    font-size: 22px;
}

.simulation-results-placeholder h3 {
    margin: 0 0 9px;
    color: #28374c;
    font-size: 14px;
    font-weight: 800;
}

.simulation-results-placeholder p {
    max-width: 480px;
    margin: 0;
    color: #8390a2;
    font-size: 11px;
    line-height: 1.9;
}

.simulation-result-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
    margin-bottom: 22px;
}

.simulation-result-card {
    min-width: 0;
    padding: 17px;
    border: 1px solid #e7edf3;
    border-radius: 11px;
    background: #fbfcfe;
}

.simulation-result-card > span {
    display: block;
    margin-bottom: 13px;
    color: #718096;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.7;
}

.simulation-result-card > strong {
    display: block;
    color: #1c2d43;
    font-size: 25px;
    font-weight: 800;
    line-height: 1.3;
    overflow-wrap: anywhere;
}

.simulation-result-card > small {
    display: block;
    margin-top: 9px;
    color: #8a96a7;
    font-size: 9px;
    line-height: 1.7;
}

/* RESULT SUMMARY */
.simulation-result-summary {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 17px;
    margin-bottom: 22px;
    border: 1px solid #cce9e7;
    border-radius: 11px;
    background: #f0fbfa;
}

.simulation-result-summary-icon {
    display: flex;
    flex: 0 0 37px;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    border-radius: 10px;
    background: #d8f2ef;
    color: #087f8c;
}

.simulation-result-summary h3 {
    margin: 2px 0 8px;
    color: #176b70;
    font-size: 12px;
    font-weight: 800;
}

#simulationResultFindings {
    color: #54777a;
    font-size: 11px;
    line-height: 1.9;
    overflow-wrap: anywhere;
}

#simulationResultFindings ul {
    padding-left: 18px;
    margin: 8px 0 0;
}

#simulationResultFindings li {
    margin-bottom: 5px;
}

/* ACTIVITY LOG */
.simulation-log-panel {
    margin-bottom: 23px;
}

.simulation-activity-log {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.simulation-log-empty {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 19px;
    border: 1px dashed #dce4ed;
    border-radius: 10px;
    color: #8a96a7;
    font-size: 11px;
}

.simulation-log-empty i {
    font-size: 15px;
}

.simulation-log-entry {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 15px 3px;
    border-bottom: 1px solid #edf1f5;
}

.simulation-log-entry:last-child {
    border-bottom: none;
}

.simulation-log-icon {
    display: flex;
    flex: 0 0 32px;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eaf5f5;
    color: #087f8c;
    font-size: 12px;
}

.simulation-log-icon.warning {
    background: #fff4df;
    color: #b77b13;
}

.simulation-log-icon.danger {
    background: #fff0ef;
    color: #d44949;
}

.simulation-log-content {
    flex: 1;
    min-width: 0;
}

.simulation-log-content strong {
    display: block;
    margin-bottom: 5px;
    color: #344258;
    font-size: 11px;
    font-weight: 800;
}

.simulation-log-content p {
    margin: 0;
    color: #8290a2;
    font-size: 10px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

.simulation-log-time {
    flex-shrink: 0;
    color: #99a3b1;
    font-size: 9px;
}

/* FOOTER */
.simulation-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 5px 0 12px;
    color: #8994a5;
    font-size: 10px;
    line-height: 1.7;
}

.simulation-footer span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #59687d;
    font-weight: 700;
}

.simulation-footer i {
    color: #087f8c;
}

/* FOCUS */
.simulation-page button:focus-visible,
.simulation-page select:focus-visible,
.simulation-page input:focus-visible {
    outline: 3px solid rgba(8, 127, 140, 0.24);
    outline-offset: 2px;
}

/* TABLET */
@media (max-width: 1200px) {
    .simulation-page {
        padding: 23px;
    }

    .simulation-kpi-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .simulation-workspace {
        grid-template-columns: minmax(0, 1fr);
    }

    .simulation-result-kpi-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* MOBILE */
@media (max-width: 768px) {
    .simulation-page {
        padding: 17px;
    }

    .simulation-heading {
        flex-direction: column;
        gap: 15px;
    }

    .simulation-heading-badge {
        align-self: flex-start;
    }

    .simulation-panel {
        padding: 17px;
    }

    .simulation-scenario-info {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .simulation-kpi-card {
        padding: 16px;
    }

    .simulation-kpi-value {
        font-size: 26px;
    }

    .simulation-result-kpi-grid {
        gap: 10px;
    }

    .simulation-result-card {
        padding: 14px;
    }

    .simulation-footer {
        align-items: flex-start;
        flex-direction: column;
    }
}

/* SMALL MOBILE */
@media (max-width: 430px) {
    .simulation-page {
        padding: 12px;
    }

    .simulation-heading h1 {
        font-size: 26px;
    }

    .simulation-heading p {
        font-size: 12px;
    }

    .simulation-kpi-grid {
        gap: 9px;
    }

    .simulation-kpi-card {
        padding: 12px;
    }

    .simulation-kpi-top {
        align-items: flex-start;
        gap: 6px;
    }

    .simulation-kpi-top > span:first-child {
        font-size: 10px;
    }

    .simulation-kpi-icon {
        flex-basis: 31px;
        width: 31px;
        height: 31px;
        font-size: 12px;
    }

    .simulation-kpi-value {
        font-size: 23px;
    }

    .simulation-kpi-card > p {
        font-size: 9px;
    }

    .simulation-panel {
        padding: 13px;
    }

    .simulation-panel-heading h2 {
        font-size: 13px;
    }

    .simulation-panel-heading p {
        font-size: 10px;
    }

    .simulation-button-row {
        grid-template-columns: minmax(0, 1fr);
    }

    .simulation-scenario-info {
        grid-template-columns: minmax(0, 1fr);
        gap: 15px;
    }

    .simulation-result-kpi-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .simulation-result-card > strong {
        font-size: 22px;
    }

    .simulation-notice {
        padding: 13px;
    }

    .simulation-notice p {
        font-size: 10px;
    }

    .simulation-log-time {
        display: none;
    }
}

/* REDUCED MOTION */
@media (prefers-reduced-motion: reduce) {
    .simulation-page *,
    .simulation-page *::before,
    .simulation-page *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
